ht:400;line-height:1.8;margin-top:24px}.profile-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.profile-actions .button{margin:0;padding:12px 20px;font-size:.875rem;color:#231f1e;background:#d2a23f;border-color:#d2a23f}.profile-actions .button-secondary{color:#fff;background:0 0;border-color:#e1dbd5}a:focus-visible,summary:focus-visible{outline:3px solid #d2a23f;outline-offset:5px}#research,#about,#portfolio{scroll-margin-top:80px}.research-section{margin:64px 0;color:#e1dbd5}.research-section>h2{font-weight:700;letter-spacing:2px;margin-bottom:28px}.research-card{background:#2b2624;border:1px solid #5b5049;border-left:4px solid #5cb0a6;border-radius:12px;padding:clamp(20px,4vw,40px)}.research-card p{font-size:1rem;line-height:1.7}.research-card h3{color:#fff;font-size:clamp(1.35rem,3vw,1.85rem);line-height:1.3}.research-card h4{color:#89d0c6;font-size:1rem}.research-card .research-status{color:#89d0c6;font-size:.875rem;font-weight:500}.research-card .research-affiliation{color:#bdb5ad;font-size:.875rem}.research-card summary{cursor:pointer;color:#e1dbd5;padding:12px 0}.research-card details p{margin-top:12px}.research-link{display:inline-block;color:#edb66c;margin-top:20px;text-decoration:underline}.research-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:24px 0;margin:24px 0;border-block:1px solid #5b5049}.research-metrics div{display:flex;flex-direction:column}.research-metrics dt{font-size:.875rem;font-weight:400}.research-metrics dd{order:-1;color:#fff;font-size:2rem;font-weight:500;margin:0}.education{margin-top:48px}.selected-projects{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:36px;text-align:left}.project-card{padding:26px;background:#2b2624;border:1px solid #5b5049;border-radius:12px;color:#e1dbd5}.project-card h3{color:#fff;font-size:1.4rem;line-height:1.35}.project-card .project-context{color:#edb66c;font-size:.875rem}.project-card dl{margin:24px 0 0}.project-card dt{color:#bdb5ad;font-size:.875rem;margin-top:18px}.project-card dd{font-size:1rem;line-height:1.6;margin:5px 0 0}.project-card .project-outcome{color:#edb66c;font-weight:500}.github-heading{color:#e1dbd5;font-size:1.25rem;margin-top:64px;letter-spacing:2px}@media(max-width:767px){.header{min-height:auto;padding:100px 0 56px}.header .head-container{flex:0 0 100%;max-width:100%}.selected-projects{grid-template-columns:1fr}.research-metrics{grid-template-columns:1fr;gap:16px}.research-metrics div{flex-direction:row;align-items:baseline;gap:16px}.research-metrics dd{min-width:100px}.journey-scroll{overflow:visible}.journey-head,.journey-axis,.journey-grid{display:none}.journey-body{display:block;height:auto}.journey-lanes{display:flex;flex-direction:column;gap:24px}.journey-lane{padding-left:16px;border-left:2px solid #5b5049;border-radius:0;background:0 0}.journey-mobile-heading{display:block;font-size:1rem;margin:0 0 12px}.journey-bar{position:static;height:auto;padding:16px;margin-top:12px;overflow:visible;box-shadow:none}.journey-bar:hover{transform:none;box-shadow:none}.journey-bar .journey-bar-title{font-size:1rem;line-height:1.4}.journey-bar .journey-bar-sub{font-size:.875rem;opacity:1}.journey-period{display:block;font-size:.875rem;margin-top:8px}.journey-milestone{position:static;order:1;border:0;pointer-events:auto}.journey-milestone-label{position:static;display:block;white-space:normal;font-size:.875rem;line-height:1.5;padding:16px}.github-grid{grid-template-columns:minmax(0,1fr)}}